{
	"name": "fogdex",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "node --env-file-if-exists=.env scripts/prepare-data.ts && astro build",
		"build:typecheck": "astro check",
		"data:pull": "node --env-file-if-exists=.env scripts/sync-data.ts pull",
		"data:push": "node --env-file-if-exists=.env scripts/sync-data.ts push",
		"dev": "astro dev",
		"fmt": "oxlint --fix && oxfmt",
		"lint": "oxlint && oxfmt --check",
		"preview": "astro preview",
		"validate-data": "node --env-file-if-exists=.env scripts/validate-data.ts"
	},
	"dependencies": {
		"@astrojs/react": "^7.1.9",
		"@astrojs/sitemap": "^3.7.6",
		"astro": "^7.4.13",
		"nuqs": "^2.10.3",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@aws-sdk/client-s3": "^3.1173.0",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"oxc-transform-react": "^0.158.0",
		"oxfmt": "^0.79.0",
		"oxlint": "^1.94.0",
		"oxlint-tsgolint": "^7.0.2007",
		"sharp": "^0.35.5",
		"tailwindcss": "^4.3.5",
		"typescript": "~6.0.3",
		"wrangler": "^4.165.0",
		"zod": "^4.6.7"
	},
	"packageManager": "pnpm@12.21.0"
}
