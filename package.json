{
	"name": "fogdex",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "node --env-file-if-exists=.env scripts/prepare-data.ts && astro build",
		"build:typecheck": "astro check",
		"data:pull": "node --env-file-if-exists=.env scripts/sync-data.ts pull",
		"data:push": "node --env-file-if-exists=.env scripts/sync-data.ts push",
		"dev": "astro dev",
		"fmt": "oxlint --fix && oxfmt",
		"lint": "oxlint && oxfmt --check",
		"preview": "astro preview",
		"validate-data": "node --env-file-if-exists=.env scripts/validate-data.ts"
	},
	"dependencies": {
		"@astrojs/react": "^7.0.0",
		"@astrojs/sitemap": "^3.7.4",
		"astro": "^7.3.5",
		"nuqs": "^2.10.1",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@aws-sdk/client-s3": "^3.1145.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^25.9.9",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"oxc-transform-react": "^0.152.0",
		"oxfmt": "^0.71.0",
		"oxlint": "^1.87.0",
		"oxlint-tsgolint": "^7.0.2003",
		"sharp": "^0.35.5",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"wrangler": "^4.146.0",
		"zod": "^4.6.5"
	},
	"packageManager": "pnpm@12.8.1"
}
