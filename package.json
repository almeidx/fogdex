{
	"name": "fogdex",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "node --env-file-if-exists=.env scripts/prepare-data.ts && astro build",
		"build:typecheck": "astro check",
		"data:pull": "node --env-file-if-exists=.env scripts/sync-data.ts pull",
		"data:push": "node --env-file-if-exists=.env scripts/sync-data.ts push",
		"dev": "astro dev",
		"fmt": "biome check --write",
		"lint": "biome check",
		"preview": "astro preview",
		"validate-data": "node --env-file-if-exists=.env scripts/validate-data.ts"
	},
	"dependencies": {
		"@astrojs/react": "^6.0.4",
		"@astrojs/sitemap": "^3.7.3",
		"astro": "^7.2.9",
		"nuqs": "^2.10.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@aws-sdk/client-s3": "^3.1120.0",
		"@biomejs/biome": "^2.5.11",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^25.9.5",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"sharp": "^0.35.4",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"wrangler": "^4.127.0",
		"zod": "^4.4.3"
	},
	"packageManager": "pnpm@11.24.0"
}
